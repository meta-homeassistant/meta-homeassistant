{
    "description": "HomeAssistant",
    "sources": {
        "bitbake": {
            "git-remote": {
                "uri": "https://git.openembedded.org/bitbake",
                "branch": "master",
                "rev": "master"
            }
        },
        "meta-clang-revival": {
            "git-remote": {
                "uri": "https://github.com/zboszor/meta-clang-revival.git",
                "branch": "main",
                "rev": "04e76d4be7e9e1cbf3958592d18b2cbf2e15d90e"
            }
        },
        "meta-homeassistant": {
            "local": {
                "path": "../../.."
            }
        },
        "meta-openembedded": {
            "git-remote": {
                "uri": "https://git.openembedded.org/meta-openembedded",
                "branch": "master",
                "rev": "533d0a63ac2a38e77746e32458e09461f12737b6"
            }
        },
        "meta-python-ai": {
            "git-remote": {
                "uri": "https://github.com/Gerry546/meta-python-ai.git",
                "branch": "blacksail",
                "rev": "aa7f5ba73e1f802bcd31c008c9c95d73893c4252"
            }
        },
        "meta-sca": {
            "git-remote": {
                "uri": "https://github.com/priv-kweihmann/meta-sca.git",
                "branch": "master",
                "rev": "8a5361097fb775f4626a21138271e3564202c9d2"
            }
        },
        "meta-virtualization": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-virtualization",
                "branch": "master",
                "rev": "7b0154418de3350fd23a0bd868742f2b570b24d3"
            }
        },
        "meta-yocto": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-yocto",
                "branch": "blacksail",
                "rev": "d0119aa2eb77b985fcd33ac527d5c0287eb68e58"
            }
        },
        "openembedded-core": {
            "git-remote": {
                "uri": "https://git.openembedded.org/openembedded-core",
                "branch": "master",
                "rev": "dd2ee1de4147f402ab25f8ad87137dd2004b494c"
            }
        },
        "yocto-docs": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/yocto-docs",
                "branch": "blacksail",
                "rev": "blacksail"
            }
        }
    },
    "bitbake-setup": {
        "configurations": [
            {
                "name": "homeassistant-x86",
                "description": "HomeAssistant X86",
                "bb-layers": [
                    "meta-clang-revival",
                    "meta-homeassistant",
                    "meta-openembedded/meta-filesystems",
                    "meta-openembedded/meta-multimedia",
                    "meta-openembedded/meta-networking",
                    "meta-openembedded/meta-oe",
                    "meta-openembedded/meta-python",
                    "meta-python-ai",
                    "meta-sca",
                    "meta-virtualization",
                    "meta-yocto/meta-yocto-bsp",
                    "openembedded-core/meta"
                ],
                "setup-dir-name": "homeassistant-x86",
                "oe-fragments": [
                    "core/yocto/root-login-with-empty-password",
                    "distro/homeassistant",
                    "homeassistant/licenses/commercial",
                    "machine/qemux86-64"
                ]
            }
        ]
    },
    "version": "1.0"
}
