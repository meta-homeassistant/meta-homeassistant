From c8c4cd126ea81d484983f994cb8cd62f52d7d901 Mon Sep 17 00:00:00 2001
From: loqs <loqs@users.noreply.github.com>
Date: Wed, 6 May 2026 13:48:00 +0100
Subject: [PATCH] Python 3.16 compat: use `inspect.iscoroutinefunction()`

PR #567

- Replaces asyncio.iscoroutinefunction deprecated in Python 3.14.
- inspect.iscoroutinefunction has been available since Python 3.9.

asyncio.iscoroutinefunction() is deprecated since Python 3.14, and the
test suite turns the warning into an error.

Upstream-Status: Backport [https://github.com/aio-libs/aiosmtpd/commit/c8c4cd126ea81d484983f994cb8cd62f52d7d901]
Signed-off-by: Thomas Roos <thomas@roosesweb.de>
---
 aiosmtpd/smtp.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/aiosmtpd/smtp.py b/aiosmtpd/smtp.py
index 3b85fcfb5..fd1fb5a04 100644
--- a/aiosmtpd/smtp.py
+++ b/aiosmtpd/smtp.py
@@ -1526,7 +1526,7 @@ async def smtp_DATA(self, arg: str) -> None:
                 assert self.session is not None
                 args = (self.session.peer, self.envelope.mail_from,
                         self.envelope.rcpt_tos, self.envelope.content)
-                if asyncio.iscoroutinefunction(
+                if inspect.iscoroutinefunction(
                         self.event_handler.process_message):
                     status = await self.event_handler.process_message(*args)
                 else:
