From 5108621355ae5d83d8d9fe3e011740bcfae4fa2c Mon Sep 17 00:00:00 2001
From: Tom Geelen <t.f.g.geelen@gmail.com>
Date: Fri, 6 Nov 2026 21:11:15 +0100
Subject: [PATCH] Fix synchronous connections without a current event loop

Signed-off-by: Tom Geelen <t.f.g.geelen@gmail.com>
Upstream-Status: Pending
---
 devolo_plc_api/device.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/devolo_plc_api/device.py b/devolo_plc_api/device.py
index 4bfdec8..b52795e 100644
--- a/devolo_plc_api/device.py
+++ b/devolo_plc_api/device.py
@@ -148,7 +148,10 @@ class Device:
 
     def connect(self) -> None:
         """Connect to a device synchronous."""
-        self._loop = asyncio.get_event_loop()
+        try:
+            self._loop = asyncio.get_event_loop()
+        except RuntimeError:
+            self._loop = asyncio.new_event_loop()
         self._loop.run_until_complete(self.async_connect())
 
     async def async_disconnect(self) -> None:
