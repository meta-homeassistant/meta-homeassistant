From: Tom Geelen <t.f.g.geelen@gmail.com>
Date: Sat, 24 Oct 2026 23:46:12 +0200
Subject: [PATCH] Fixes the shared RAOP TXT fixture name so it matches the RAOP
 service record; this resolves the host-targeted scan failure.

Signed-off-by: Tom Geelen <t.f.g.geelen@gmail.com>
Upstream-Status: Pending
---
 tests/core/test_scan.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/core/test_scan.py b/tests/core/test_scan.py
index 1523e84..eedb7ed 100644
--- a/tests/core/test_scan.py
+++ b/tests/core/test_scan.py
@@ -111,7 +111,7 @@ RAOP_SERVICE_RECORD = DNSService(
     "Ohana.local.",
 )
 RAOP_TXT_RECORD = DNSText(
-    "Ohana._airplay._tcp.local.",
+    "54E61BF2ED74@Ohana._raop._tcp.local.",
     const._TYPE_TXT,
     const._CLASS_IN,
     const._DNS_OTHER_TTL,
