From bfdff227792ef61473be60459846caa06ccb7aa4 Mon Sep 17 00:00:00 2001
From: Tom Geelen <t.f.g.geelen@gmail.com>
Date: Sat, 27 Sep 2025 21:31:02 +0200
Subject: [PATCH] fix compilation

Signed-off-by: Tom Geelen <t.f.g.geelen@gmail.com>
Upstream-Status: Pending
---
 pyproject.toml | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 56dc993..1d7f8f1 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -45,13 +45,13 @@ requires = ["hatchling"]
 build-backend = "hatchling.build"
 
 [tool.hatch.build]
-sources = ["src"]
+sources = ["."]
 
 [tool.hatch.build.targets.wheel]
-packages = ["src/evohomeasync", "src/evohomeasync2", "src/_evohome", "src/evohome_cli"]
+packages = ["evohomeasync", "evohomeasync2", "_evohome", "evohome_cli"]
 
 [tool.hatch.version]
-path = "src/_evohome/__init__.py"
+path = "_evohome/__init__.py"
 
 
 #
@@ -73,6 +73,6 @@ python_version = "3.13"
 
 exclude = ["docs", "tests/tests_cc"]
-files = ["src", "tests"]
+files = ["evohomeasync", "evohomeasync2", "_evohome", "evohome_cli", "tests"]
 
 no_implicit_optional = true
