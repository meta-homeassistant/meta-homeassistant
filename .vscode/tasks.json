{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Bitbake Setup - Init HomeAssistant",
            "type": "shell",
            "command": "clear && ${cwd}/sources/bitbake/bin/bitbake-setup init ${cwd}/configurations/homeassistant.conf.json homeassistant-x86",
            "group": "none",
            "problemMatcher": []
        },
        {
            "label": "Build HomeAssistant Target",
            "type": "shell",
            "group": "build",
            "command": "clear && source ${cwd}/bitbake-builds/homeassistant-x86/build/init-build-env && bitbake core-image-homeassistant-full"
        },
        {
            "label": "Run HomeAssistant QEMU Image",
            "type": "shell",
            "group": "test",
            "command": "clear && source ${cwd}/bitbake-builds/homeassistant-x86/build/init-build-env && runqemu core-image-homeassistant-full snapshot slirp kvm nographic"
        },
        {
            "label": "Test HomeAssistant Basic Tests",
            "type": "shell",
            "command": "clear && bash ${cwd}/tests/image/test-basic-homeassistant.sh --source",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test HomeAssistant Layer - All Packages",
            "type": "shell",
            "command": "clear && bash ${cwd}/tests/image/test-all-layer-packages.sh --source",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test HomeAssistant Layer - Single Package",
            "type": "shell",
            "command": "clear && bash ${cwd}/tests/image/test-single-layer-packages.sh --source ${input:package-name}",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test Plain Pytest Tests",
            "type": "shell",
            "command": "clear && bash ${cwd}/tests/image/test-pytest-plain.sh --wrapper homeassistant-x86 --target core-image-homeassistant-full --package ${input:package-name} --no-default-runqemu-args --runqemu-arg slirp --runqemu-arg snapshot --runqemu-arg nographic",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test HomeAssistant Offline Unit Tests",
            "type": "shell",
            "command": "\"${cwd}/.venv/bin/python\" -m unittest discover -s \"${cwd}/tests/unit\" -t \"${cwd}\"",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Upgrade Home Assistant Release",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python ${workspaceFolder}/scripts/upgrade_homeassistant.py --release ${input:ha-release} --layer-dir ${workspaceFolder} --setup-dir ${workspaceFolder}/bitbake-builds/homeassistant-x86 --wrapper homeassistant-x86 --target core-image-homeassistant-full --core-ptest-target core-image-homeassistant-full",
            "group": "build",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "package-name",
            "type": "promptString",
            "description": "Enter the name of the package to test (e.g. 'python3-homeassistant')"
        },
        {
            "id": "ha-release",
            "type": "promptString",
            "description": "Home Assistant Core release tag (for example 2026.3.1)"
        }
    ]
}